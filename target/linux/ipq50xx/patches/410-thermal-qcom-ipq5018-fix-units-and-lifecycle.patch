+	}
+	INIT_WORK(&tmdev->tsens_work, tsens_scheduler_fn);
+
+	/* Keep alarms masked until calibration and its lookup tables are ready. */
+	ret = regmap_write(tmdev->tm_map, TSENS_TM_INT_EN_ADDR, 0);
+	if (ret)
+		goto err_disable;
 	reg_cntl = SW_RST;
 	ret = regmap_update_bits(tmdev->srot_map, TSENS_CNTL_ADDR, SW_RST, reg_cntl);
 	if (ret)
-		return ret;
+		goto err_disable;
 
 	reg_cntl |= SLP_CLK_ENA | (MEASURE_PERIOD << 18);
 	reg_cntl &= ~SW_RST;
-	ret = regmap_update_bits(tmdev->srot_map, TSENS_CONFIG_ADDR,
-				CONFIG_MASK, CONFIG);
-
+	ret = regmap_update_bits(tmdev->srot_map, TSENS_CONFIG_ADDR, CONFIG_MASK, CONFIG);
+	if (ret)
+		goto err_disable;
 	reg_cntl |= GENMASK(MAX_SENSOR - 1, 0) << SENSOR0_SHIFT;
 	ret = regmap_write(tmdev->srot_map, TSENS_CNTL_ADDR, reg_cntl);
 	if (ret)
-		return ret;
-
+		goto err_disable;
 	reg_cntl |= EN;
 	ret = regmap_write(tmdev->srot_map, TSENS_CNTL_ADDR, reg_cntl);
 	if (ret)
-		return ret;
