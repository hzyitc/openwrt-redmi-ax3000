 							   &priv->sensor[i],
 							   &tsens_of_ops);
-		if (IS_ERR(tzd))
-			continue;
+		if (IS_ERR(tzd)) {
+			ret = PTR_ERR(tzd);
+			if (ret == -ENODEV)
+				continue;
+			return ret;
+		}
+		registered++;
 		priv->sensor[i].tzd = tzd;
 		if (priv->ops->enable)
 			priv->ops->enable(priv, i);
-	}
-	return 0;
+
+		if (priv->ops == &ops_ipq5018) {
+			ret = thermal_add_hwmon_sysfs(tzd);
+			if (ret) {
+				dev_warn(priv->dev, "sensor %d hwmon registration failed: %d\n",
+					 i, ret);
+				continue;
+			}
+			if (tzd->tzp)
+				tzd->tzp->no_hwmon = false;
+			ret = devm_add_action_or_reset(priv->dev, tsens_remove_hwmon, tzd);
+			if (ret)
+				dev_warn(priv->dev, "sensor %d hwmon cleanup registration failed: %d\n",
+					 i, ret);
+		}
+	}
+	return registered ? 0 : -ENODEV;
 }
 
 static int tsens_probe(struct platform_device *pdev)
