 	priv->ops = data->ops;
 
-	priv->tsens_irq = platform_get_irq(pdev, 0);
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0 && priv->ops == &ops_ipq5018)
+		return irq;
+	priv->tsens_irq = irq;
 
 	for (i = 0;  i < priv->num_sensors; i++) {
 		if (data->hw_ids)
@@ -219,14 +256,21 @@
 		if (ret < 0) {
 			if (ret != -EPROBE_DEFER)
 				dev_err(dev, "tsens calibration failed\n");
-			return ret;
+			goto err_disable;
 		}
 	}
 
 	ret = tsens_register(priv);
+	if (ret)
+		goto err_disable;
 
 	platform_set_drvdata(pdev, priv);
 
+	return 0;
+
+err_disable:
+	if (priv->ops->disable)
+		priv->ops->disable(priv);
 	return ret;
 }
 
