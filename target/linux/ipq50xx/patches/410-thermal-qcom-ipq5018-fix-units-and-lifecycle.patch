 	ret = regmap_field_read(priv->rf[TSENS_EN], &enabled);
 	if (ret)
 		goto err_put_device;
-	if (!enabled) {
+	/* IPQ5018 enables its sensors after the register maps are ready. */
+	if (!enabled && priv->ops != &ops_ipq5018) {
 		dev_err(dev, "tsens device is not enabled\n");
 		ret = -ENODEV;
 		goto err_put_device;
@@ -238,6 +239,7 @@
 		}
