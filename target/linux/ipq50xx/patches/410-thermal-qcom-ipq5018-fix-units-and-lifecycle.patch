+static void tsens_remove_hwmon(void *data)
+{
+	struct thermal_zone_device *tzd = data;
+
+	thermal_remove_hwmon_sysfs(tzd);
+	if (tzd->tzp)
+		tzd->tzp->no_hwmon = true;
