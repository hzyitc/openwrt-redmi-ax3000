 static inline int code_to_degc(u32 adc_code, const struct tsens_sensor *s)
@@ -343,10 +389,10 @@
 static int calibrate_ipq5018(struct tsens_priv *tmdev)
 {
 	u32 base0 = 0, base1 = 0;
-	u32 p1[MAX_SENSOR], p2[MAX_SENSOR];
+	u32 p1[MAX_SENSOR] = {0}, p2[MAX_SENSOR] = {0};
 	u32 mode = 0, lsb = 0, msb = 0;
 	u32 *qfprom_cdata;
-	int i, sensor;
+	int ret, i, sensor;
 
 	qfprom_cdata = (u32 *)qfprom_read(tmdev->dev, "calib");
 	if (IS_ERR(qfprom_cdata))
@@ -402,12 +448,23 @@
 	kfree(qfprom_cdata);
 
 	for (sensor = 0; sensor < tmdev->num_sensors; sensor++) {
+		if (tmdev->sensor[sensor].slope <= 0)
+			return -EINVAL;
 		for (i = MIN_ADC; i <= MAX_ADC; i++) {
 			code2degc_lut_degc[sensor][i] = code_to_degc(i,
 							&tmdev->sensor[sensor]);
 		}
 	}
 
+	/* Publish all slopes, offsets and lookup tables before admitting IRQ work. */
+	smp_store_release(&tmdev->ready, true);
+	ret = regmap_write(tmdev->tm_map, TSENS_TM_INT_EN_ADDR, TSENS_TM_INT_EN);
+	if (ret) {
+		smp_store_release(&tmdev->ready, false);
+		return ret;
+	}
+	if (!enable_irq_wake(tmdev->tsens_irq))
+		tmdev->irq_wake_enabled = true;
 	return 0;
 }
 
@@ -415,19 +472,32 @@
 {
 	const struct tsens_sensor *s = data;
 
-	if (!s)
-		return -EINVAL;
-
-	return set_trip_temp(s->priv, s->id, trip, temp);
+	if (!s || !s->priv)
+		return -EINVAL;
+	if (!smp_load_acquire(&s->priv->ready))
+		return -EAGAIN;
+
+	if (temp < MIN_TEMP * 1000 || temp > MAX_TEMP * 1000)
+		return -EINVAL;
+
+	/* The thermal ABI uses milliCelsius; the ADC lookup uses Celsius. */
+	return set_trip_temp(s->priv, s->id, trip, DIV_ROUND_CLOSEST(temp, 1000));
 }
 
 static int get_temp_ipq5018(struct tsens_priv *tmdev, int id, int *temp)
 {
-	const struct tsens_sensor *s = &tmdev->sensor[id];
+	const struct tsens_sensor *s;
 	u32 code;
 	unsigned int sensor_addr;
 	int ret, last_temp = 0, last_temp2 = 0, last_temp3 = 0;
 
+	if (!tmdev || !temp || id < 0 || id >= tmdev->num_sensors)
+		return -EINVAL;
+	if (!smp_load_acquire(&tmdev->ready))
+		return -EAGAIN;
+	s = &tmdev->sensor[id];
+	if (s->slope <= 0)
+		return -EINVAL;
 	sensor_addr = TSENS_TM_SN_STATUS + s->hw_id * 4;
 	ret = regmap_read(tmdev->tm_map, sensor_addr, &code);
 	if (ret)
@@ -462,9 +532,11 @@
 		last_temp = last_temp2;
 	else if (last_temp2 == last_temp3)
 		last_temp = last_temp3;
+	else
+		return -EAGAIN;
 done:
-	/* Convert temperature from ADC code to Celsius */
-	*temp = code_to_degc(last_temp, s);
+	/* Convert temperature from ADC code to milliCelsius. */
+	*temp = code_to_degc(last_temp, s) * 1000;
 
 	return 0;
 }
