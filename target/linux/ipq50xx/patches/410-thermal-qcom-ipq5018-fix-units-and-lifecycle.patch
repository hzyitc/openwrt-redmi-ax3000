+
 	/*Check whether TSENS is enabled */
-	regmap_read(tmdev->srot_map, TSENS_CNTL_ADDR, &reg_val);
+	if (regmap_read(tmdev->srot_map, TSENS_CNTL_ADDR, &reg_val))
+		return;
 	if (!(reg_val & TSENS_SN_CTRL_EN))
 		return;
 
@@ -217,7 +230,8 @@
 		/* Reset for each iteration */
 		reg_thr = th_upper = th_lower = 0;
 
-		regmap_read(tmdev->tm_map, tmdev->sensor[i].status, &reg_val);
+		if (regmap_read(tmdev->tm_map, tmdev->sensor[i].status, &reg_val))
+			continue;
 
 		/* Check whether the temp is valid */
 		if (!(reg_val & TSENS_TM_SN_STATUS_VALID_BIT))
@@ -237,16 +251,20 @@
 		}
 
 		if (th_upper || th_lower) {
-			regmap_write(tmdev->tm_map, reg_addr, reg_thr);
-			/* Notify user space */
+			/* The acknowledgement bits share the threshold register. */
+			if (regmap_write_bits(tmdev->tm_map, reg_addr, reg_thr, reg_thr))
+				continue;
+
+			if (int_clr_deassert_quirk &&
+			    regmap_write_bits(tmdev->tm_map, reg_addr, reg_thr, 0))
+				continue;
+
+			/* Notify user space after acknowledging the interrupt. */
 			schedule_work(&tmdev->sensor[i].notify_work);
-
-			if (int_clr_deassert_quirk)
-				regmap_write(tmdev->tm_map, reg_addr, 0);
 
 			if (!get_temp_ipq5018(tmdev, i, &temp))
 				pr_debug("Trigger (%d degrees) for sensor %d\n",
-					temp, i);
+					temp / 1000, i);
 		}
 	}
 
@@ -260,6 +278,31 @@
 
 	schedule_work(&tmdev->tsens_work);
 	return IRQ_HANDLED;
+}
+
+static void disable_ipq5018(struct tsens_priv *tmdev)
+{
+	int i;
+
+	smp_store_release(&tmdev->ready, false);
+	regmap_write(tmdev->tm_map, TSENS_TM_INT_EN_ADDR, 0);
+	if (tmdev->irq_requested) {
+		disable_irq(tmdev->tsens_irq);
+		tmdev->irq_requested = false;
+	}
+	if (tmdev->irq_wake_enabled) {
+		disable_irq_wake(tmdev->tsens_irq);
+		tmdev->irq_wake_enabled = false;
+	}
+	cancel_work_sync(&tmdev->tsens_work);
+	for (i = 0; i < tmdev->num_sensors; i++)
+		cancel_work_sync(&tmdev->sensor[i].notify_work);
+	regmap_update_bits(tmdev->srot_map, TSENS_CNTL_ADDR, EN, 0);
+}
+
+static void stop_ipq5018(void *data)
+{
+	disable_ipq5018(data);
 }
 
 static int init_ipq5018(struct tsens_priv *tmdev)
@@ -268,57 +311,60 @@
 	int i;
 	u32 reg_cntl;
 
